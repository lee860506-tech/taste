# Kakao Maps JavaScript key (not REST API key or Admin key)
# Public browser SDK key. Restrict allowed domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

DATA_GO_KR_SERVICE_KEY=
# Supabase project URL and publishable key (read-only via RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Use a new sb_secret_ key; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# A long random value used only to authorize the server-side sync endpoint.
RESTAURANT_SYNC_TOKEN=
